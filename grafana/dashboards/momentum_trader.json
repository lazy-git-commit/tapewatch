{
  "__requires": [
    { "type": "datasource", "id": "frser-sqlite-datasource", "version": "4.0.3" }
  ],
  "uid": "momentum-trader-v1",
  "title": "Momentum Trader",
  "tags": ["trading"],
  "timezone": "browser",
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "mode",
        "label": "Mode",
        "type": "custom",
        "query": "demo,live",
        "current": { "text": "demo", "value": "demo" },
        "options": [
          { "text": "demo", "value": "demo", "selected": true },
          { "text": "live", "value": "live", "selected": false }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Open Trades",
      "type": "table",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 6 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "trader-sqlite" },
      "targets": [
        {
          "rawQuery": "SELECT ticker, quantity, buy_price, buy_time, ROUND((JULIANDAY('now') - JULIANDAY(buy_time)) * 1440, 0) AS age_minutes FROM trades WHERE status = 'open' AND mode = '$mode' ORDER BY buy_time DESC",
          "queryType": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Win Rate",
      "type": "stat",
      "gridPos": { "x": 0, "y": 6, "w": 4, "h": 4 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "trader-sqlite" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 40 },
              { "color": "green", "value": 55 }
            ]
          }
        }
      },
      "targets": [
        {
          "rawQuery": "SELECT ROUND(100.0 * SUM(CASE WHEN profit_loss > 0 THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0), 1) AS win_rate_pct FROM trades WHERE status = 'closed' AND mode = '$mode'",
          "queryType": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Total Realised P&L",
      "type": "stat",
      "gridPos": { "x": 4, "y": 6, "w": 4, "h": 4 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "trader-sqlite" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]
          }
        }
      },
      "targets": [
        {
          "rawQuery": "SELECT ROUND(SUM(profit_loss), 2) AS total_pnl FROM trades WHERE status = 'closed' AND mode = '$mode'",
          "queryType": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total Trades",
      "type": "stat",
      "gridPos": { "x": 8, "y": 6, "w": 4, "h": 4 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "trader-sqlite" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "rawQuery": "SELECT COUNT(*) AS total_trades FROM trades WHERE status = 'closed' AND mode = '$mode'",
          "queryType": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Portfolio Value Over Time",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "trader-sqlite" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP"
        }
      },
      "targets": [
        {
          "rawQuery": "SELECT CAST(strftime('%s', snapshot_at) AS INTEGER) * 1000 AS time, total_value FROM portfolio_snapshots ORDER BY snapshot_at ASC",
          "queryType": "time series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Trade History",
      "type": "table",
      "gridPos": { "x": 0, "y": 10, "w": 24, "h": 8 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "trader-sqlite" },
      "targets": [
        {
          "rawQuery": "SELECT ticker, ROUND(buy_price, 4) AS buy_price, ROUND(sell_price, 4) AS sell_price, ROUND(quantity, 4) AS quantity, ROUND(profit_loss, 2) AS pnl_gbp, ROUND(profit_loss_pct, 2) AS pnl_pct, exit_reason, sell_time FROM trades WHERE status = 'closed' AND mode = '$mode' ORDER BY sell_time DESC LIMIT 100",
          "queryType": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Signal History",
      "type": "table",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 8 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "trader-sqlite" },
      "targets": [
        {
          "rawQuery": "SELECT created_at, ticker, sentiment, confidence, acted_on, headline, source FROM news_signals ORDER BY created_at DESC LIMIT 200",
          "queryType": "table",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 38
}
