# ── API Keys ──────────────────────────────────────────────────────────────────
# Trading 212: generate at https://app.trading212.com → Settings → API
TRADING212_API_KEY=your_trading212_api_key_here

# News API: get a free key at https://newsapi.org
NEWSAPI_KEY=your_newsapi_key_here

# Anthropic: get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Trading Mode ───────────────────────────────────────────────────────────────
# Set to "demo" while paper trading. Change to "live" only when ready.
TRADING_MODE=demo

# ── Strategy Settings ─────────────────────────────────────────────────────────
# Minimum sentiment confidence score (1–10) to act on a news signal
MIN_SENTIMENT_CONFIDENCE=7

# Price must have moved up at least this % since market open to confirm signal
MIN_PRICE_MOVE_PCT=1.5

# Max % of total portfolio to deploy in a single trade
MAX_POSITION_SIZE_PCT=5.0

# Sell when price is this % above buy price (take profit)
TAKE_PROFIT_PCT=5.0

# Sell when price is this % below buy price (stop loss)
STOP_LOSS_PCT=2.0

# Sell if position not closed within this many minutes (time stop)
TIME_STOP_MINUTES=60

# ── News Settings ─────────────────────────────────────────────────────────────
# How often to poll for news (in minutes)
NEWS_POLL_INTERVAL_MINUTES=5

# Watchlist: comma-separated list of stock tickers to monitor
# These must be valid Trading 212 instrument codes for equities
WATCHLIST=AAPL_US_EQ,TSLA_US_EQ,AMZN_US_EQ

# ── Storage ───────────────────────────────────────────────────────────────────
DB_PATH=./trader.db
