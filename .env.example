# ── API Keys ──────────────────────────────────────────────────────────────────
# Trading 212: generate at https://app.trading212.com → Settings → API (live account)
TRADING212_API_KEY=your_trading212_live_api_key_here
TRADING212_API_KEY_ID=your_trading212_live_api_key_id_here

# Trading 212: demo account API keys (used when TRADING_MODE=demo)
TRADING212_DEMO_API_KEY=your_trading212_demo_api_key_here
TRADING212_DEMO_API_KEY_ID=your_trading212_demo_api_key_id_here

# Benzinga: get your key at https://www.benzinga.com/apis/
BENZINGA_API_KEY=your_benzinga_api_key_here

# ── Trading Mode ───────────────────────────────────────────────────────────────
# Set to "demo" while paper trading. Change to "live" only when ready.
TRADING_MODE=demo

# Simulated portfolio value used for position sizing in demo mode (GBP)
DEMO_PORTFOLIO_VALUE=500.0

# ── Strategy Settings ─────────────────────────────────────────────────────────
# Minimum sentiment confidence score (1–10) to act on a news signal
MIN_SENTIMENT_CONFIDENCE=7

# Price must have moved up at least this % within the momentum window to confirm signal
MIN_PRICE_MOVE_PCT=0.5

# Look-back window (minutes) for recent momentum calculation
MOMENTUM_WINDOW_MINUTES=30

# Reject signal if stock is down more than this % from today's open (dead-cat bounce guard)
MAX_DAY_DROP_PCT=3.0

# Max % of total portfolio to deploy in a single trade
MAX_POSITION_SIZE_PCT=5.0

# Sell when price is this % above buy price (take profit)
TAKE_PROFIT_PCT=5.0

# Sell when price is this % below buy price (stop loss)
STOP_LOSS_PCT=2.0

# Sell if position not closed within this many minutes (time stop)
TIME_STOP_MINUTES=60

# ── News Settings ─────────────────────────────────────────────────────────────
# How often to poll for news (in minutes)
NEWS_POLL_INTERVAL_MINUTES=5

# Blocklist: comma-separated Trading 212 instrument codes to never trade
# Leave empty to allow all tickers found in news
BLOCKLIST=

# ── Storage ───────────────────────────────────────────────────────────────────
DB_URL=postgresql://<db-user>:<db-password>@localhost:5432/momentum_trader
