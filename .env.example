# ── API Keys ──────────────────────────────────────────────────────────────────
# Trading 212: generate at https://app.trading212.com → Settings → API (live account)
TRADING212_API_KEY=your_trading212_live_api_key_here
TRADING212_API_KEY_ID=your_trading212_live_api_key_id_here

# Trading 212: demo account API keys (used when TRADING_MODE=demo)
TRADING212_DEMO_API_KEY=your_trading212_demo_api_key_here
TRADING212_DEMO_API_KEY_ID=your_trading212_demo_api_key_id_here

# Benzinga news via massive.com — https://massive.com
MASSIVE_BENZINGA_API_KEY=your_massive_benzinga_api_key_here

# Finnhub: real-time stock quotes — https://finnhub.io
FINNHUBIO_API_KEY=your_finnhub_api_key_here

# Twelvedata: intraday 1-min bars for momentum baseline (replaces yfinance)
# Basic plan: 800 credits/day, 1 credit per symbol per call — https://twelvedata.com
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# Anthropic: Claude for news sentiment classification — https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Trading Mode ───────────────────────────────────────────────────────────────
# Set to "demo" while paper trading. Change to "live" only when ready.
TRADING_MODE=demo

# ─────────────────────────────────────────────────────────────────────────────
# NOTE: production .env is written by .github/workflows/deploy.yml. Any new
# setting added here must be added there too (and vice versa) — a required
# key missing from the workflow crash-loops the service at startup.
# Full filter rationale: docs/algorithm.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Entry filters ─────────────────────────────────────────────────────────────
# Minimum Claude confidence (1–10) to act on a positive signal
MIN_SENTIMENT_CONFIDENCE=7
# Minimum catalyst magnitude (1–5) to trade. 1=noise/PT-raise, 2=modest, 3=material, 4=major, 5=transformative.
MIN_CATALYST_MAGNITUDE=2

# Momentum confirmation (v15). The real "is it being accumulated?" test is
# VWAP (size-neutral — works for micro-caps and mega-caps alike); the % floor
# is now only a dead-tape noise filter. See docs/algorithm.md §4.
#   MIN_PRICE_MOVE_PCT  — dead-tape floor: catalyst must have moved the stock
#                         AT ALL. Keep low (0.2) when VWAP confirmation is on;
#                         raise to ~1.5 if you set REQUIRE_VWAP_CONFIRMATION=false.
#   MAX_PRICE_MOVE_PCT  — post-halt spike ceiling (unchanged).
#   REQUIRE_VWAP_CONFIRMATION — require price held at/above session VWAP.
#   VWAP_TOLERANCE_PCT  — how far below VWAP still accepted (fresh-reclaim slack).
MIN_PRICE_MOVE_PCT=0.2
MAX_PRICE_MOVE_PCT=15.0
REQUIRE_VWAP_CONFIRMATION=true
VWAP_TOLERANCE_PCT=0.1

# VWAP extension ceiling (v20): max entry distance ABOVE VWAP. Keep BELOW
# STOP_LOSS_PCT — if entry is further above value than the stop is wide, a
# routine reversion to VWAP hits the stop by construction (LEVI/CRCL).
# Transient reject: the re-eval queue enters on the first pullback instead.
MAX_VWAP_EXTENSION_PCT=1.5

# Intraday exhaustion gate (v19.5). day_change_pct (vs yesterday's close) and
# recent_move_pct (last ~5 min) can both look clean on a stock that gapped
# down hard and clawed most of the way back — they only see the endpoints,
# not the day's shape. This rejects a price that has already recovered most
# of a large intraday low-to-high range (chasing the tail of a bounce).
#   REQUIRE_EXHAUSTION_CHECK       — toggle the gate.
#   EXHAUSTION_MIN_RANGE_PCT       — day's low-to-high range must be at least
#                                    this % (of the low) to count as a real
#                                    round trip, not noise.
#   EXHAUSTION_RECOVERY_THRESHOLD  — fraction (0-1) of that range already
#                                    recovered before rejecting.
REQUIRE_EXHAUSTION_CHECK=true
EXHAUSTION_MIN_RANGE_PCT=5.0
EXHAUSTION_RECOVERY_THRESHOLD=0.75

# Reject if already up more than this % vs the PREVIOUS CLOSE (gap included) —
# the catalyst has paid out; entries here buy exhaustion.
# v21.11: 25.0 → 10.0, calibrated on all 24 closed trades. With a 2% stop and
# a 5% target, entering a stock already up 15% needs +21% on the day to pay
# out while a routine pullback stops you — the risk:reward is inverted before
# you enter. 10% is the tightest ceiling that blocks only losers.
MAX_DAY_MOVE_PCT=10.0

# Max age (seconds) of the quote an ENTRY decision is made on. Deliberately
# separate from the 20-minute coverage staleness guard in price_check: that
# one answers "is this ticker covered at all?", this one answers "is this
# price safe to buy against right now?". A lagging quote doesn't make the
# gates fail — it makes them all agree on a market that has moved on.
MAX_ENTRY_QUOTE_AGE_SECONDS=90

# Momentum look-back window (minutes). Bars selected by timestamp.
MOMENTUM_LOOKBACK_MINUTES=5

# Dead-cat guard: reject if down more than this % vs previous close.
MAX_DAY_DROP_PCT=3.0

# Liquidity floor: 20-day AVERAGE daily dollar volume (ADV × price).
# ADV-based on purpose — spike-day volume would pass exactly the halt
# patterns this filter exists to block.
MIN_DAILY_DOLLAR_VOLUME=5000000

# RVOL band (time-of-day normalized relative volume). 1.0 = normal pace.
# Floor confirms real participation; ceiling catches the halt pattern.
MIN_RVOL=1.5
MAX_RVOL=20.0

# Size-neutral bypass of the RVOL FLOOR only: at/above this ADV$, a held
# VWAP substitutes for RVOL (a mega-cap's book is already huge in dollar
# terms, so it doesn't need anomalous relative volume to make a real move).
RVOL_BYPASS_MIN_ADV_DOLLAR=50000000

# Penny-stock floor. Sub-$5 names: outsized spreads, halts, manipulation.
MIN_STOCK_PRICE=5.0

# Spread proxy ceiling: (high−low)/close of the latest 1-min bar, %.
MAX_SPREAD_PCT=3.0

# Block trades for N minutes after the open (opening auction noise).
OPEN_BLOCK_MINUTES=5

# Catalyst classes allowed to trade (Claude tags every article; code gates).
# v20: pruned to the classes with MEASURED positive forward returns in the
# eval loop (fda_approval +1.42%/60min n=86, guidance_raise +2.97%/60min n=9;
# contract_win/earnings_beat/product_launch/ma_target all measured NEGATIVE —
# see config/settings.py for the full table). Re-enable only with evidence.
#
# v21.16: fda_approval dropped. Raw forward return asks "does the stock drift
# up?"; simulating the trade (entry at signal, -2% stop, +5% TP, 120-min hold,
# 0.46pp costs) asks whether the trade survives to collect the drift:
#   guidance_raise n=193  net +0.667%/trade  50% win  t=5.51
#   fda_approval   n=106  net -0.146%/trade  32% win  t=1.44
# 32% sits below the 33% break-even that T212's FX round trip imposes. Still
# scored and still accruing forward returns, so this is reversible on evidence.
TRADEABLE_CATALYSTS=guidance_raise

# Catalyst classes that enter at the SIGNAL rather than waiting for the
# momentum floor (v21.16). The floor genuinely selects better stocks (+0.86%
# vs +0.11% @60m) but waiting for it costs ~2% of entry price, which leaves the
# -2% stop at the price the news fired at, where ordinary reversion stops us
# out. Only the floor is skipped, and only on flat tape — active selling, the
# momentum ceiling, VWAP, RVOL and liquidity all still reject.
# Requires REQUIRE_VWAP_CONFIRMATION=true (enforced by cfg.validate()): VWAP is
# the remaining market-agreement evidence once the floor is off.
# Empty = wait for momentum confirmation on every class (pre-v21.16 behaviour).
SKIP_MOMENTUM_CATALYSTS=guidance_raise

# ── Entry price ceiling (v21.17) ─────────────────────────────────────────────
# Buy with a LIMIT at decision-price x (1 + slack) instead of at market. A
# market buy accepts whatever the book offers: LAMR (2026-08-06) was sized on
# $161.09 and filled at $164.30 -- above the stock's high for the entire
# session -- which left the -2% stop at the price the news had fired at.
# An unfilled limit is NOT a rejection: the signal returns to the re-eval
# queue, so a refused price costs the fill, never the idea.
# Must stay below STOP_LOSS_PCT (enforced by cfg.validate()): an entry further
# above our chosen price than the stop is wide begins inside its own stop.
ENTRY_LIMIT_ENABLED=true
ENTRY_LIMIT_SLACK_PCT=0.4

# ── Portfolio circuit breakers (v21.17) ──────────────────────────────────────
# MAX_DAILY_LOSS_PCT resets at midnight and therefore cannot see a slow bleed.
# MAX_DRAWDOWN_PCT stops new entries when equity is this far below its peak
# over DRAWDOWN_LOOKBACK_DAYS (open positions are still managed and exited).
# Fails OPEN on a data error -- only the daily kill switch fails closed.
# LOSS_STREAK_HALT pauses entries after N consecutive losing trades: a run of
# stop-outs is information about the tape, not about the next signal.
# Set either to 0 to disable.
MAX_DRAWDOWN_PCT=10.0
DRAWDOWN_LOOKBACK_DAYS=30
LOSS_STREAK_HALT=4
LOSS_STREAK_COOLDOWN_MINUTES=90

# ── Position sizing & portfolio risk ──────────────────────────────────────────
# Hard cap: max % of portfolio in one position.
MAX_POSITION_SIZE_PCT=5.0

# Risk budget: a stop-loss hit costs at most this % of equity.
RISK_PER_TRADE_PCT=0.25

# Liquidity participation: position ≤ this % of the stock's ADV dollars,
# so our own exit can't move the price.
MAX_ADV_PARTICIPATION_PCT=0.5

# ── Qwen (Alibaba Cloud Model Studio) — OPTIONAL ──────────────────────────────
# v21.14 shadow mode: every batch sent to Claude is ALSO sent to Qwen, on a
# background thread, purely to collect latency/liveness/prediction data. Claude
# remains the only verdict that reaches a trading decision — nothing is read
# back. cfg.validate() does not require these: unset simply means "no shadow
# data", never a startup failure.
# Read the collected data with:
#     python -m analysis.classifier_compare --days 14
# Use the DEDICATED workspace Base URL from the Model Studio console (each
# workspace gets its own inference domain), not the shared dashscope-intl one.
QWEN_API_KEY=
QWEN_BASE_URL=https://<your-workspace>.eu-central-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-flash

# Portfolio gates.
# v21.13: MAX_OPEN_POSITIONS 3 → 8, to stop concurrency capping the sample size
# while the strategy is still being measured. Worst case is bounded: 8 × ~5% of
# portfolio = ~40% deployed, and 8 simultaneous stop-outs at −2% is ~0.8% of
# portfolio — well inside MAX_DAILY_LOSS_PCT. MAX_TRADES_PER_DAY still caps the
# day at 10. NOTE: this gate has never actually rejected a signal (0 hits since
# 2026-08-01); signals are limited by the price gates, not by concurrency.
MAX_OPEN_POSITIONS=8
MAX_TRADES_PER_DAY=10

# Daily kill switch: realized loss beyond this % of portfolio stops all new
# entries until tomorrow. The single most important live-trading control.
MAX_DAILY_LOSS_PCT=2.0

# ── Exit management ───────────────────────────────────────────────────────────
# v20 exit inversion: the STOP LOSS is a RESTING stop-market order placed at
# buy time (zero latency on the side where latency costs capital); the take
# profit is polled by the monitor. T212 has no OCO, so only one side can rest.
TAKE_PROFIT_PCT=5.0
STOP_LOSS_PCT=2.0
# TIME_STOP_MINUTES is the HOLD horizon. The forward-return panel (2026-07-20)
# showed the tradeable-catalyst edge (guidance_raise +3.8%/60m, fda_approval
# +1.1%/60m) still climbing at 60 min, so 60 clipped it mid-move.
# RAISED TO 120 IN PRODUCTION 2026-07-30 (v21.8) — this file now matches.
TIME_STOP_MINUTES=120
# How late to keep OPENING positions (minutes before the session's hard exit).
# Decoupled from the hold so a longer TIME_STOP_MINUTES doesn't collapse the
# entry window. Unset → falls back to TIME_STOP_MINUTES (unchanged behavior);
# set it (e.g. 60) when you lengthen the hold so afternoon entries still open.
ENTRY_CUTOFF_MINUTES=60
RESTING_STOP_ENABLED=true

# Breakeven ratchet: at +RATCHET_TRIGGER_PCT the stop moves to
# buy × (1 + RATCHET_LOCK_PCT/100), once — a trade that paid 1R may
# mean-revert but must not become a loser.
RATCHET_TRIGGER_PCT=2.0
RATCHET_LOCK_PCT=0.1

# Position monitor cadence (seconds). The polled side (take profit) pays this
# as latency; the loop early-outs when no positions are open.
MONITOR_INTERVAL_SECONDS=5

# Force-close ALL positions this many minutes before the close.
# Day-trading system: stops don't work overnight.
EOD_FLATTEN_MINUTES=10

# Stop sells are LIMIT orders at trigger × (1 − this %) — bounds slippage
# (GOAI filled −18.99% on a −2% stop with a market order).
SELL_LIMIT_SLACK_PCT=1.0

# ── Pre-market pipeline ───────────────────────────────────────────────────────
# Scores overnight/pre-market news into a watchlist; candidates are evaluated
# AT THE OPEN with gap + momentum confirmation. Never pre-places orders.
PREMARKET_ENABLED=true
# 07:00 ET catches the early catalyst block. Scanning earlier only builds the
# news watchlist (Benzinga+Claude) — no price-API calls until the open.
PREMARKET_SCAN_START_ET=07:00

# Gap band at evaluation: below min the market doesn't believe the catalyst;
# above max the move is exhausted.
MIN_GAP_PCT=1.0
MAX_GAP_PCT=20.0

# ── 24/5 extended-hours trading (v21) ───────────────────────────────────────────
# Master switch — mirror of whether 24/5 trading is enabled on the T212 account.
# When false the system is exactly its pre-v21 RTH-only self.
EXTENDED_HOURS_ENABLED=true
# After-hours entries (16:00–20:00 ET) — where FDA/guidance catalysts print.
AFTERHOURS_TRADING_ENABLED=true
# Direct pre-market entries (04:00–09:30 ET). Default off: the pre-market
# scanner + at-open gap-and-go evaluation is the deliberate pre-market strategy.
PREMARKET_TRADING_ENABLED=false
# Extended sessions only touch institutional-depth names (ADV$ floor) …
EXTENDED_MIN_ADV_DOLLAR=50000000
# … that have actually printed real dollars in the session so far (replaces
# the RVOL band, whose time-of-day curve only means something during RTH).
EXTENDED_MIN_SESSION_DOLLAR_VOLUME=500000
# Tighter spread proxy ceiling out here (RTH uses MAX_SPREAD_PCT=3.0).
EXTENDED_MAX_SPREAD_PCT=1.5
# Extended entries are scaled down: the loss side is POLLED after hours
# (T212 stop orders execute RTH-only), so risk is cut at the sizing stage.
EXTENDED_SIZE_FACTOR=0.5
# Force-flatten everything this many minutes before 20:00 ET — the overnight
# session runs on Blue Ocean, which our data providers do not carry.
EXTENDED_FLATTEN_BUFFER_MINUTES=15

# ── Observability ───────────────────────────────────────────────────────────────
# Alert (CRITICAL log + system_events row) after this many consecutive NYSE
# trading sessions with zero trades while the service is up and scoring news.
# Tripwire for silent data-pipeline failures (Twelvedata credit exhaustion,
# Claude outage). Alerts only — never stands the system down.
ZERO_TRADE_ALERT_SESSIONS=3

# ── News Settings ─────────────────────────────────────────────────────────────
# Blocklist: comma-separated Trading 212 instrument codes to never trade
BLOCKLIST=

# ── Storage ───────────────────────────────────────────────────────────────────
DB_URL=postgresql://<db-user>:<db-password>@localhost:5432/momentum_trader
